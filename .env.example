# ==============================================================================
# HawaSaathi AI - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' for local development.
# In Vercel, configure these variables under:
# Project Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Configuration (Required for Live AI Insights)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
# If unset, HawaSaathi AI automatically activates its built-in CPCB & WHO
# deterministic expert safety engine without crashing.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Gemini Model name (Defaults to 'gemini-2.5-flash')
# Options: 'gemini-2.5-flash', 'gemini-2.0-flash', 'gemini-1.5-pro'
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Local Backend Server Configuration (Local Development Only)
# ------------------------------------------------------------------------------
# Port for the local Express development server (Vite proxies /api to this port).
# Vercel ignores this in production as serverless functions handle /api automatically.
PORT=3001
